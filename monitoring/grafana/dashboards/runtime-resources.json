{
  "title": "Runtime / Resources",
  "uid": "vitamins-runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Process CPU seconds / sec",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"gateway\"}[5m])", "legendFormat": "cpu" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Process resident memory",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"gateway\"}", "legendFormat": "rss" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "go_goroutines{job=\"gateway\"}", "legendFormat": "goroutines" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GC pause (p95)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(go_gc_duration_seconds_bucket{job=\"gateway\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Process uptime (seconds)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "time() - process_start_time_seconds{job=\"gateway\"}", "legendFormat": "uptime" }]
    }
  ]
}

